# Firebase (social: accounts, friends, sharing, circles)
# Create a free project at https://console.firebase.google.com
# Then Project settings → Your apps → Web app → copy config values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — show Continue with Apple (requires Apple provider enabled in Firebase Auth)
# VITE_FIREBASE_APPLE_AUTH=true

# Optional — Web Push (Firebase Console → Project settings → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
