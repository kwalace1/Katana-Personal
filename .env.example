# Supabase (social: accounts, friends, sharing, circles, feed)
# Create a project at https://supabase.com — then Settings → API.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — show Continue with Apple (requires Apple provider enabled in Supabase Auth)
# VITE_SUPABASE_APPLE_AUTH=true

# Optional — OpenRouter for open-ended Ask (server-only; never use VITE_ prefix)
# Create a key at https://openrouter.ai/keys
# Local: `npm run dev` serves /api/ask-llm via Vite. Production: set these in Vercel env, then redeploy.
OPENROUTER_API_KEY=
# Default Gemini Flash on OpenRouter. Swap freely, e.g. google/gemini-2.5-flash-lite
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional — Web Push (iOS Home Screen PWA background alerts). Public key is safe in the client.
# Generate with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# SUPABASE_SERVICE_ROLE_KEY=   # server-only — push cron + schedule
# CRON_SECRET=                 # Vercel cron auth header

# Production origin the iOS binary uses for /api/* (Ask, food, account delete)
# VITE_APP_URL=https://katana-personal.vercel.app

# Optional — Stripe web billing for Katana Plus (web only; iOS uses RevenueCat)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=

# RevenueCat public Apple API key (safe in the client). Required for App Store Plus.
# Dashboard → Project → Apple app → Public API key (starts with appl_)
# VITE_REVENUECAT_APPLE_API_KEY=

# Optional — Google Calendar + Google Tasks (Settings → Connections)
# Same OAuth Web client can serve both. Add BOTH redirect URIs:
#   https://YOUR_DOMAIN/api/integrations/google
#   https://YOUR_DOMAIN/api/integrations/google-tasks
#   http://localhost:3001/api/integrations/google
#   http://localhost:3001/api/integrations/google-tasks
# Enable Calendar API + Tasks API. VITE_GOOGLE_CLIENT_ID is Config (public); secret stays Secret.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional separate Tasks client id (defaults to VITE_GOOGLE_CLIENT_ID)
# VITE_GOOGLE_TASKS_CLIENT_ID=

# Optional — Outlook / Microsoft Calendar
# Azure app registration redirect:
#   https://YOUR_DOMAIN/api/integrations/outlook
#   http://localhost:3001/api/integrations/outlook
VITE_MS_CLIENT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional — Todoist
# App OAuth redirect:
#   https://YOUR_DOMAIN/api/integrations/todoist
#   http://localhost:3001/api/integrations/todoist
VITE_TODOIST_CLIENT_ID=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Weather uses free Open-Meteo (no API key). Shown on Today + Health cardio.
