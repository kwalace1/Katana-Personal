# Katana – copy to .env and fill in values.
# Full list and details: see ENV.md

# =============================================================================
# Access Gate (universal password to enter the app)
# =============================================================================
# Set this to require a password before the login screen loads.
# Leave blank or omit to disable the gate entirely.
VITE_ACCESS_PASSWORD=

# Local dev: skip Microsoft sign-in (npm run dev only; shows "Continue without sign-in (dev)")
VITE_DEV_AUTH_BYPASS=
# Real Supabase dev user (required for database writes with dev bypass)
VITE_DEV_EMAIL=dev@localhost
VITE_DEV_PASSWORD=
# Optional display name for npm run dev:seed
# VITE_DEV_FULL_NAME=Dev User

# =============================================================================
# Pilot module access (optional)
# =============================================================================
# Comma-separated module IDs for pilot users (members). Non-admin users only see
# modules in this list AND what an owner/admin assigned in HR. Owners/admins are
# not limited. Recommended paid pilot package (Hub + Support + PM + HR + Customers + KYI):
# VITE_PILOT_MODULES=hub,support,projects,hr,customer-success,employee,kyi
# Example for a Hub + PM + Employee Portal pilot:
# VITE_PILOT_MODULES=hub,projects,employee,careers

VITE_PILOT_MODULES=

# =============================================================================
# Supabase (required for Sign in with Microsoft)
# =============================================================================
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# See SUPABASE_AUTH_SETUP.md for full Microsoft login setup.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only: used by npm run dev:seed (never expose in client builds)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================================================
# EmailJS (for demo request emails and project invite emails)
# =============================================================================
# Get these from https://www.emailjs.com/ — see EMAILJS_SETUP.md
# For project invites (Share tab), use a service connected to:
#   katanatechnologysystems@gmail.com
# so invitations are sent from that address.

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Optional: separate EmailJS service/template for project invitations (Share tab).
# If set, invitations are sent using this service (connect it to katanatechnologysystems@gmail.com).
# If not set, the service/template above are used.
# VITE_EMAILJS_INVITE_SERVICE_ID=your_invite_service_id_here
# VITE_EMAILJS_INVITE_TEMPLATE_ID=your_invite_template_id_here

# =============================================================================
# Katana Support (pilot issue reporting & feedback)
# =============================================================================
# Support is FULLY PRE-WIRED in code — service, template, AND the EmailJS public
# key (service_svo9pq8 / template_u1xja4v + public key) all ship as defaults, so
# NO env vars are required for support email to send. The public key is a
# client-side identifier (it ships in the bundle by design); abuse is gated by
# EmailJS → Account → Security → Allowed Domains, so add your deployment URL
# (and http://localhost:3001 for dev) there. See EMAILJS_SETUP.md.
#
# Inbox where all support tickets are emailed (Katana pilot team — not org admins).
# Replies go back to the submitter; the email template uses reply_to for that.
# VITE_SUPPORT_INBOX_EMAIL=katanatechnologysystems@gmail.com

# Optional overrides (only set to point support at a different EmailJS setup).
# Resolution order: VITE_EMAILJS_SUPPORT_* → VITE_EMAILJS_* → built-in defaults.
# VITE_EMAILJS_SUPPORT_SERVICE_ID=your_support_service_id_here
# VITE_EMAILJS_SUPPORT_TEMPLATE_ID=your_support_template_id_here
# VITE_EMAILJS_PUBLIC_KEY=your_public_key_here   # overrides the built-in default

# Katana platform operator — cross-tenant support ticket access (Pilot Queue)
# Owner/admin users with these email domains see ALL pilot submissions in Katana Support.
VITE_KATANA_PLATFORM_EMAIL_DOMAINS=dwgrowthcapital.onmicrosoft.com,dwgrowth.onmicrosoft.com
# Optional: restrict by organization UUID instead of/in addition to email domain
# VITE_KATANA_PLATFORM_ORG_ID=

# Optional: Tenor API key for GIF search in Katana Comms
# VITE_TENOR_API_KEY=your_tenor_api_key_here

# =============================================================================
# AI Chat (Katana Sync / KSync) – at least one key required for AI features
# =============================================================================
# Provider fallback order: Groq → Cerebras → Mistral.
# All use open-source models (Llama / Mistral) with free tiers.
# Set these in Vercel: Settings → Environment Variables.

# Groq – Llama 3.3 70B (US, fastest, 1,000 req/day free)
# Sign up: https://console.groq.com
GROQ_API_KEY=

# Cerebras – Llama 3.3 70B (US, 1M tokens/day free)
# Sign up: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Mistral – Mistral Large (EU/Paris, 1B tokens/month free)
# Sign up: https://console.mistral.ai
MISTRAL_API_KEY=

# Optional RAG (retrieved documentation in Katana Sync): apply supabase-rag-schema.sql, index chunks into rag_documents.
# Uses the same MISTRAL_API_KEY for mistral-embed (1024-dim vectors). If the table/RPC is empty or the key is missing, RAG is skipped.
# KSYNC_RAG_DISABLED=true
# KATANABOT_RAG_DISABLED=true  # legacy alias

# =============================================================================
# Know Your Investor (KYI) – optional embedded module
# =============================================================================
# URL of the KYI Flask app to embed in the KYI module (e.g. http://localhost:5000).
# If unset, the KYI page shows setup instructions.
# VITE_KYI_APP_URL=http://localhost:5000

# Path to KYI CSV data for import (fec_donors.csv, sec_13f.csv, etc.).
# Default: katana/data/kyi (no need to set unless using another folder).
# KYI_DATA_PATH=./data/kyi

# Client ID used as the platform lead pool (all imports go here; every company sees this pool filtered by their geo). Default: 1.
# KYI_PLATFORM_CLIENT_ID=1

# =============================================================================
# Katana Switch integration (migration ingest API)
# =============================================================================
# Server-only. Required for /switch/oauth/token and /switch/ingest/* endpoints.
# Run supabase-switch-integration-migration.sql in Supabase SQL Editor first.
#
# KATANA_API_BASE_URL — returned in OAuth token response; set per environment:
#   Dev:     http://localhost:3001
#   Staging: https://your-staging-url.vercel.app
#   Prod:    https://katana-vv2.vercel.app
# KATANA_API_BASE_URL=http://localhost:3001
#
# OAuth client credentials (client_credentials grant). Switch uses these to obtain Bearer tokens.
# SWITCH_OAUTH_CLIENT_ID=switch-dev
# SWITCH_OAUTH_CLIENT_SECRET=generate-a-long-random-secret
# SWITCH_DEFAULT_ORG_ID=<organization-uuid-from-supabase>
# SWITCH_ACTING_USER_ID=<auth-user-uuid-for-writes-optional>
#
# --- Katana → Switch Import divert (Phase 1 handoff) ---
# Contract: Katana Switch/docs/KATANA_IMPORT_HANDOFF.md
# Client flag (optional global enable; org setting switch_import_divert also works):
# VITE_SWITCH_IMPORT_DIVERT=true
# Prefer full handoff URL (prod):
# SWITCH_HANDOFF_URL=https://veyah.vercel.app/api/katana/handoff
# Or base URL → appends /api/katana/handoff:
# SWITCH_API_BASE_URL=https://veyah.vercel.app
# Shared with Switch Vercel env (HTTP Basic):
# SWITCH_HANDOFF_CLIENT_ID=katana-saas-prod
# SWITCH_HANDOFF_CLIENT_SECRET=
# SWITCH_HANDOFF_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# actor.organization_id is rewritten to SWITCH_HANDOFF_ORGANIZATION_ID on the proxy.

# --- Agent Office (SwarmClaw headless engine) ---
# Base URL of the agent service. Dev: http://localhost:3456. Prod: your Fly.io app URL.
VITE_AGENT_OFFICE_URL=http://localhost:3456
# Access key for the agent service API (sent as X-Access-Key).
VITE_AGENT_OFFICE_ACCESS_KEY=
# Optional: explicit WebSocket URL (defaults: dev ws://localhost:3457/ws, prod wss://<office-host>/ws).
# VITE_AGENT_OFFICE_WS_URL=
# Server-side (Vercel) equivalents used by the /api/office proxy — keep the key out of the client bundle in prod.
SWARMCLAW_URL=
SWARMCLAW_ACCESS_KEY=
