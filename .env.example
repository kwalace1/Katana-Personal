# Supabase (social: accounts, friends, sharing, circles, feed)
# Create a project at https://supabase.com — then Settings → API.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — show Continue with Apple (requires Apple provider enabled in Supabase Auth)
# VITE_SUPABASE_APPLE_AUTH=true

# Optional — OpenRouter for open-ended Ask (server-only; never use VITE_ prefix)
# Create a key at https://openrouter.ai/keys
# Local: `npm run dev` serves /api/ask-llm via Vite. Production: set these in Vercel env, then redeploy.
OPENROUTER_API_KEY=
# Default Gemini Flash on OpenRouter. Swap freely, e.g. google/gemini-2.5-flash-lite
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional — Web Push (iOS Home Screen PWA background alerts). Public key is safe in the client.
# Generate with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# SUPABASE_SERVICE_ROLE_KEY=   # server-only — push cron + schedule
# CRON_SECRET=                 # Vercel cron auth header

# Optional — Stripe web billing for Katana Plus (interim until App Store)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=

# Optional — Google Calendar integration (Settings → Connections)
# Create OAuth credentials at https://console.cloud.google.com/ — Web application redirect:
#   Local: http://localhost:3001/api/integrations/google?action=callback
#   Prod:  https://YOUR_DOMAIN/api/integrations/google?action=callback
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Fitbit health sync (Settings → Connections, Plus)
# Redirect: https://YOUR_DOMAIN/api/integrations/fitbit?action=callback
VITE_FITBIT_CLIENT_ID=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Optional — Strava activity sync (Settings → Connections, Plus)
# Redirect: https://YOUR_DOMAIN/api/integrations/strava?action=callback
VITE_STRAVA_CLIENT_ID=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
