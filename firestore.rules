rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /friendCodes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendships/{id} {
      allow read: if signedIn() &&
        (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if signedIn() &&
        (request.resource.data.a == request.auth.uid || request.resource.data.b == request.auth.uid);
      allow update, delete: if signedIn() &&
        (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
    }

    match /sharedItems/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.memberIds;
    }

    match /activity/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    match /streaks/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    match /circles/{id} {
      // Circle IDs aren't listed publicly; invite tokens gate discovery.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      // Members manage the circle; non-members may only add themselves (invite join).
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || (
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'updatedAt'])
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Invite links are readable by anyone signed in (token is the secret).
    match /circleInvites/{token} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /blocks/{id} {
      allow read: if signedIn() &&
        (resource.data.blocker == request.auth.uid || resource.data.blocked == request.auth.uid);
      allow create: if signedIn() && request.resource.data.blocker == request.auth.uid;
      allow delete: if signedIn() && resource.data.blocker == request.auth.uid;
      allow update: if false;
    }

    match /pushTokens/{uid} {
      allow read, write: if isSelf(uid);
    }
  }
}
