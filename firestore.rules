rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function friendshipId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(friendshipId(a, b)))
        && get(/databases/$(database)/documents/friendships/$(friendshipId(a, b))).data.status == 'accepted';
    }
    function isFriendOf(uid) {
      return areFriends(request.auth.uid, uid);
    }

    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if isSelf(uid) || isFriendOf(uid);
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /friendCodes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendships/{id} {
      allow get: if signedIn() && (
        resource == null
        || resource.data.a == request.auth.uid
        || resource.data.b == request.auth.uid
      );
      allow list: if signedIn() && (
        resource.data.a == request.auth.uid || resource.data.b == request.auth.uid
      );
      allow create: if signedIn() &&
        (request.resource.data.a == request.auth.uid || request.resource.data.b == request.auth.uid);
      allow update, delete: if signedIn() &&
        (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
    }

    match /sharedItems/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.memberIds;
    }

    match /activity/{uid} {
      // Prefer get-by-id from clients; list queries are hard to authorize with friendship checks.
      allow get: if isSelf(uid) || isFriendOf(uid);
      allow list: if false;
      allow write: if isSelf(uid);
    }

    match /streaks/{uid} {
      allow get: if isSelf(uid) || isFriendOf(uid);
      allow list: if false;
      allow write: if isSelf(uid);
    }

    match /circles/{id} {
      // get allowed so invite links can resolve before join; list stays members-only
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || (
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'updatedAt'])
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isCircleMember(circleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/circles/$(circleId))
        && request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds;
    }

    match /circleEvents/{id} {
      allow read: if isCircleMember(resource.data.circleId);
      allow create: if isCircleMember(request.resource.data.circleId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll([
          'circleId', 'title', 'notes', 'startsAt', 'endsAt', 'allDay',
          'category', 'color', 'createdBy', 'assigneeId', 'createdAt', 'updatedAt'
        ]);
      allow update, delete: if isCircleMember(resource.data.circleId);
    }

    match /circlePosts/{id} {
      allow read: if isCircleMember(resource.data.circleId);
      allow create: if isCircleMember(request.resource.data.circleId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll(['circleId', 'authorId', 'message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500;
      allow delete: if isCircleMember(resource.data.circleId)
        && resource.data.authorId == request.auth.uid;
      allow update: if false;
    }

    match /circleInvites/{token} {
      // Invitees need get-by-token; list only for creator.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      // Only create notifications addressed to someone else (or self) while signed in —
      // require the creator to be authenticated; recipients must match intended social flows.
      allow create: if signedIn()
        && request.resource.data.uid is string
        && request.resource.data.uid != request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'kind', 'title', 'body', 'read', 'createdAt']);
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /blocks/{id} {
      allow get: if signedIn() && (
        resource == null
        || resource.data.blocker == request.auth.uid
        || resource.data.blocked == request.auth.uid
      );
      allow list: if signedIn() && (
        resource.data.blocker == request.auth.uid || resource.data.blocked == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.blocker == request.auth.uid;
      allow delete: if signedIn() && resource.data.blocker == request.auth.uid;
      allow update: if false;
    }

    match /pushTokens/{uid} {
      allow read, write: if isSelf(uid);
    }
  }
}
